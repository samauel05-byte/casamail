{
  "name": "casamail",
  "version": "0.1.0",
  "description": "CasaMail: cliente de correo local (IMAP/SMTP) con IA propia, interfaz tipo Gmail y servidor MCP",
  "type": "module",
  "bin": {
    "casamail": "dist/cli.js",
    "casamail-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "web": "tsx src/web.ts",
    "mcp": "tsx src/mcp.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/web.ts",
    "test": "tsx tests/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^6.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/smtp-server": "^3.5.13",
    "hoodiecrow-imap": "^3.3.1",
    "smtp-server": "^3.21.4",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}