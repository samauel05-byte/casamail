{
  "name": "casamail",
  "version": "0.4.4",
  "description": "CasaMail: cliente de correo local con Yerleny (IA), Gmail/Outlook con OAuth y servidor MCP",
  "type": "module",
  "bin": {
    "casamail": "dist/cli.js",
    "casamail-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "web": "tsx src/web.ts",
    "mcp": "tsx src/mcp.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/web.ts",
    "test": "tsx tests/e2e.ts",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:desktop": "tsc && xvfb-run -a tsx tests/desktop.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "domhandler": "^5.0.3",
    "express": "^4.21.0",
    "htmlparser2": "^10.1.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^6.9.0",
    "pst-extractor": "^1.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/smtp-server": "^3.5.13",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "hoodiecrow-imap": "^3.3.1",
    "smtp-server": "^3.21.4",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "samauel05-byte",
    "email": "samauel05-byte@users.noreply.github.com"
  },
  "homepage": "https://github.com/samauel05-byte/casamail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samauel05-byte/casamail.git"
  },
  "build": {
    "appId": "app.casamail.desktop",
    "productName": "CasaMail",
    "copyright": "CasaMail",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json",
      "!node_modules/@node-llama-cpp/*cuda*/**",
      "!node_modules/@node-llama-cpp/*vulkan*/**"
    ],
    "artifactName": "CasaMail-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "CasaMail"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network;Email",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "samauel05-byte <samauel05-byte@users.noreply.github.com>",
      "synopsis": "Cliente de correo local con IA",
      "description": "CasaMail: tu correo en tu propio equipo, con Gmail/Outlook por OAuth y la IA Yerleny.",
      "syncDesktopName": true
    },
    "asarUnpack": [
      "node_modules/@node-llama-cpp/**",
      "node_modules/node-llama-cpp/bins/**",
      "node_modules/node-llama-cpp/llama/**"
    ]
  },
  "desktopName": "casamail.desktop",
  "optionalDependencies": {
    "node-llama-cpp": "^3.22.3"
  }
}
